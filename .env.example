# Copy this file to .env for local development.
# Commit this example file only. Never commit the real .env file.

# Common runtime
COMPOSE_PROJECT_NAME=g-civil-msa
TZ=Asia/Seoul
SPRING_PROFILES_ACTIVE=local

# Authentication. Replace JWT_SECRET outside local development.
JWT_SECRET=local-only-change-this-jwt-secret-at-least-32-characters
JWT_ACCESS_TOKEN_EXPIRATION_MS=3600000
JWT_REFRESH_TOKEN_EXPIRATION_MS=1209600000

# Kafka topics and consumer groups
KAFKA_HOST_PORT=9092
KAFKA_COMPLAINT_CREATED_TOPIC=complaint.created.v1
KAFKA_COMPLAINT_CREATED_DLT=complaint.created.v1.dlt
KAFKA_COMPLAINT_STATUS_TOPIC=complaint.status.changed.v1
KAFKA_COMPLAINT_STATUS_DLT=complaint.status.changed.v1.dlt
KAFKA_COMPLAINT_RESPONSE_TOPIC=complaint.response.registered.v1
KAFKA_COMPLAINT_RESPONSE_DLT=complaint.response.registered.v1.dlt
NOTIFICATION_KAFKA_GROUP_ID=notification-service
STATISTICS_KAFKA_GROUP_ID=statistics-service

# Local database credentials. Replace every password outside local development.
USER_DB_NAME=user_db
USER_DB_USER=user
USER_DB_PASSWORD=user_local_pw
USER_DB_ROOT_PASSWORD=user_root_local_pw
USER_DB_HOST_PORT=3310

COMPLAINT_DB_NAME=complaint_db
COMPLAINT_DB_USER=complaint
COMPLAINT_DB_PASSWORD=complaint_local_pw
COMPLAINT_DB_ROOT_PASSWORD=complaint_root_local_pw
COMPLAINT_DB_HOST_PORT=3307

DEPARTMENT_DB_NAME=department_db
DEPARTMENT_DB_USER=department
DEPARTMENT_DB_PASSWORD=department_local_pw
DEPARTMENT_DB_ROOT_PASSWORD=department_root_local_pw
DEPARTMENT_DB_HOST_PORT=3308

NOTIFICATION_DB_NAME=notification_db
NOTIFICATION_DB_USER=notification
NOTIFICATION_DB_PASSWORD=notification_local_pw
NOTIFICATION_DB_ROOT_PASSWORD=notification_root_local_pw
NOTIFICATION_DB_HOST_PORT=3309

# Reserved for Statistics Service after its port and source are confirmed.
STATISTICS_DB_NAME=statistics_db
STATISTICS_DB_USER=statistics
STATISTICS_DB_PASSWORD=statistics_local_pw
STATISTICS_DB_ROOT_PASSWORD=statistics_root_local_pw
STATISTICS_DB_HOST_PORT=3311

# Attachment storage. Local is the safe default before S3 is approved.
FILE_STORAGE_TYPE=local
LOCAL_STORAGE_PATH=/data/attachments
AWS_REGION=ap-northeast-2
S3_ATTACHMENT_BUCKET=

# Application host ports
DISCOVERY_PORT=8761
CONFIG_PORT=8888
GATEWAY_PORT=8080
COMPLAINT_PORT=8081
ASSIGNMENT_PORT=8082
NOTIFICATION_PORT=8083
USER_PORT=8084
STATISTICS_PORT=8085
