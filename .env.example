COMPOSE_PROJECT_NAME=g-civil-msa
TZ=Asia/Seoul
SPRING_PROFILES_ACTIVE=local

# Use a long random value in shared/dev environments.
JWT_SECRET=local-only-change-this-jwt-secret-at-least-32-characters
JWT_ISSUER=minwonon-auth
JWT_CLOCK_SKEW_SECONDS=30
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Attachment storage. Local development does not require AWS credentials.
FILE_STORAGE_TYPE=local
AWS_REGION=ap-northeast-2
S3_ATTACHMENT_BUCKET=
S3_ATTACHMENT_PREFIX=complaints/

KAFKA_COMPLAINT_CREATED_TOPIC=complaint.created.v1
KAFKA_COMPLAINT_CREATED_DLT=complaint.created.v1.dlt
KAFKA_COMPLAINT_STATUS_CHANGED_TOPIC=complaint.status.changed.v1
KAFKA_COMPLAINT_STATUS_CHANGED_DLT=complaint.status.changed.v1.dlt
KAFKA_COMPLAINT_RESPONSE_REGISTERED_TOPIC=complaint.response.registered.v1
KAFKA_COMPLAINT_RESPONSE_REGISTERED_DLT=complaint.response.registered.v1.dlt

USER_DB_NAME=user_db
USER_DB_USER=user
USER_DB_PASSWORD=user_local_pw
USER_DB_ROOT_PASSWORD=user_root_local_pw

# Local database credentials. Change every password outside local development.
COMPLAINT_DB_NAME=complaint_db
COMPLAINT_DB_USER=complaint
COMPLAINT_DB_PASSWORD=complaint_local_pw
COMPLAINT_DB_ROOT_PASSWORD=complaint_root_local_pw

ASSIGNMENT_DB_NAME=assignment_db
ASSIGNMENT_DB_USER=assignment
ASSIGNMENT_DB_PASSWORD=assignment_local_pw
ASSIGNMENT_DB_ROOT_PASSWORD=assignment_root_local_pw

NOTIFICATION_DB_NAME=notification_db
NOTIFICATION_DB_USER=notification
NOTIFICATION_DB_PASSWORD=notification_local_pw
NOTIFICATION_DB_ROOT_PASSWORD=notification_root_local_pw

STATISTICS_DB_NAME=statistics_db
STATISTICS_DB_USER=statistics
STATISTICS_DB_PASSWORD=statistics_local_pw
STATISTICS_DB_ROOT_PASSWORD=statistics_root_local_pw

# Host ports
KAFKA_HOST_PORT=9092
USER_DB_HOST_PORT=3310
COMPLAINT_DB_HOST_PORT=3307
ASSIGNMENT_DB_HOST_PORT=3308
NOTIFICATION_DB_HOST_PORT=3309
STATISTICS_DB_HOST_PORT=3311

DISCOVERY_PORT=8761
CONFIG_PORT=8888
GATEWAY_PORT=8080
COMPLAINT_PORT=8081
ASSIGNMENT_PORT=8082
NOTIFICATION_PORT=8083

# Email notifications (disabled until SMTP credentials are configured)
EMAIL_NOTIFICATIONS_ENABLED=false
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SMTP_AUTH=false
MAIL_STARTTLS_ENABLED=false
MAIL_FROM=no-reply@minwonon.local
USER_PORT=8084
STATISTICS_PORT=8085
