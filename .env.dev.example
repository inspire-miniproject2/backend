COMPOSE_PROJECT_NAME=g-civil-msa-dev
TZ=Asia/Seoul
SPRING_PROFILES_ACTIVE=dev

# GHCR image coordinates. Prefer an immutable seven-character commit SHA.
GHCR_OWNER=inspire-miniproject2
IMAGE_TAG=replace-with-commit-sha

# Replace every value below before deployment. Never commit .env.dev.
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters

# Complaint attachment storage. EC2 obtains AWS credentials from its IAM role.
FILE_STORAGE_TYPE=s3
AWS_REGION=ap-northeast-2
S3_ATTACHMENT_BUCKET=replace-with-private-bucket-name
S3_ATTACHMENT_PREFIX=complaints/

KAFKA_COMPLAINT_CREATED_TOPIC=complaint.created.v1
KAFKA_COMPLAINT_CREATED_DLT=complaint.created.v1.dlt
KAFKA_COMPLAINT_STATUS_CHANGED_TOPIC=complaint.status.changed.v1
KAFKA_COMPLAINT_STATUS_CHANGED_DLT=complaint.status.changed.v1.dlt
KAFKA_COMPLAINT_RESPONSE_REGISTERED_TOPIC=complaint.response.registered.v1
KAFKA_COMPLAINT_RESPONSE_REGISTERED_DLT=complaint.response.registered.v1.dlt

USER_DB_NAME=user_db
USER_DB_USER=user
USER_DB_PASSWORD=replace-with-user-db-password
USER_DB_ROOT_PASSWORD=replace-with-user-root-password

COMPLAINT_DB_NAME=complaint_db
COMPLAINT_DB_USER=complaint
COMPLAINT_DB_PASSWORD=replace-with-complaint-db-password
COMPLAINT_DB_ROOT_PASSWORD=replace-with-complaint-root-password

ASSIGNMENT_DB_NAME=assignment_db
ASSIGNMENT_DB_USER=assignment
ASSIGNMENT_DB_PASSWORD=replace-with-assignment-db-password
ASSIGNMENT_DB_ROOT_PASSWORD=replace-with-assignment-root-password

NOTIFICATION_DB_NAME=notification_db
NOTIFICATION_DB_USER=notification
NOTIFICATION_DB_PASSWORD=replace-with-notification-db-password
NOTIFICATION_DB_ROOT_PASSWORD=replace-with-notification-root-password

STATISTICS_DB_NAME=statistics_db
STATISTICS_DB_USER=statistics
STATISTICS_DB_PASSWORD=replace-with-statistics-db-password
STATISTICS_DB_ROOT_PASSWORD=replace-with-statistics-root-password

# Only the Gateway is exposed externally in the dev deployment.
GATEWAY_BIND_ADDRESS=0.0.0.0
GATEWAY_PORT=8080
DISCOVERY_PORT=8761
CONFIG_PORT=8888
USER_PORT=8084
COMPLAINT_PORT=8081
ASSIGNMENT_PORT=8082
NOTIFICATION_PORT=8083
STATISTICS_PORT=8085

# Infrastructure ports stay bound to 127.0.0.1 by docker-compose.yml.
KAFKA_HOST_PORT=9092
USER_DB_HOST_PORT=3310
COMPLAINT_DB_HOST_PORT=3307
ASSIGNMENT_DB_HOST_PORT=3308
NOTIFICATION_DB_HOST_PORT=3309
STATISTICS_DB_HOST_PORT=3311
