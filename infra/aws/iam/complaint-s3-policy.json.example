{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ListComplaintAttachments",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::REPLACE_WITH_BUCKET_NAME",
      "Condition": {
        "StringLike": {
          "s3:prefix": [
            "complaints",
            "complaints/*"
          ]
        }
      }
    },
    {
      "Sid": "ManageComplaintAttachmentObjects",
      "Effect": "Allow",
      "Action": [
        "s3:PutObject",
        "s3:GetObject",
        "s3:DeleteObject"
      ],
      "Resource": "arn:aws:s3:::REPLACE_WITH_BUCKET_NAME/complaints/*"
    }
  ]
}
